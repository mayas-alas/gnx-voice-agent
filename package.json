{
  "name": "gnx-voice-agent",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Composition-first text and voice runtime",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app/server.js",
    "dev": "node --watch --env-file-if-exists=.env app/server.js",
