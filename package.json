    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.30",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  }
}
