# GNX service identity; app.gnx and compute.gnx remain untouched.
BIND_HOST=127.0.0.1
PORT=8080
APP_ORIGIN=https://voice.gnx
# Set before exposing the reverse proxy, even with loopback binding.
GNX_API_TOKEN=

# Public AI
HF_TOKEN=
HF_MODEL=
HF_BASE_URL=https://router.huggingface.co/v1
CLOUD_ROUTE=public

# Private AI
OMNIROUTE_BASE_URL=https://omniroute.gnx/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Oryx owns persistent AI settings, TTS selection, and media lifecycle.
ORYX_BASE_URL=https://oryx.gnx
ORYX_PUBLIC_BASE_URL=https://oryx.gnx
ORYX_API_SECRET=
VOICE_ENABLED=false
# Explicit deployed text-to-speech primitive; NOT Dubbing task-tts.
ORYX_VOICE_PATH=

# MCP
MCP_CONFIG_PATH=config/mcp.json
# Set to your trusted internal CA bundle if needed. Never disable TLS checks.
# NODE_EXTRA_CA_CERTS=/path/to/gnx-ca.pem

# Runtime
REQUEST_TIMEOUT_MS=45000
VOICE_TIMEOUT_MS=15000
CORRELATION_TTL_MS=86400000
MAX_CORRELATIONS=1000
