# Public cloud: HF_TOKEN is the primary cloud credential.
HF_TOKEN=
CLOUD_ROUTE=public
HF_MODEL=
HF_BASE_URL=https://router.huggingface.co/v1

# Private cloud gateway (upstream privacy depends on its configuration).
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Oryx is the voice/media runtime. Supply a deployed text-to-voice bridge.
ORYX_BASE_URL=http://localhost:2022
ORYX_TOKEN=
ORYX_VOICE_PATH=
VOICE_ENABLED=false
TTS_MODEL=
TTS_VOICE=default
# Optional public origin for relative audio URLs returned by Oryx.
ORYX_PUBLIC_BASE_URL=

MCP_CONFIG_PATH=config/mcp.json
HOST=127.0.0.1
PORT=8080
# Required when binding beyond loopback; also usable on localhost.
GNX_API_TOKEN=
REQUEST_TIMEOUT_MS=45000
VOICE_TIMEOUT_MS=15000
CORRELATION_TTL_MS=86400000
MAX_CORRELATIONS=1000
