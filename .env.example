# Deployment: https://voice.gnx -> reverse proxy -> 127.0.0.1:8080
# app.gnx and compute.gnx are already occupied; do not reuse them.
# Public cloud: HF_TOKEN is the primary cloud credential.
HF_TOKEN=
CLOUD_ROUTE=public
HF_MODEL=
HF_BASE_URL=https://router.huggingface.co/v1

# Private cloud gateway (upstream privacy depends on its configuration).
OMNIROUTE_BASE_URL=https://omniroute.gnx/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Oryx is the voice/media runtime. Supply a deployed text-to-voice bridge.
ORYX_BASE_URL=https://oryx.gnx
ORYX_TOKEN=
ORYX_VOICE_PATH=
VOICE_ENABLED=false
TTS_MODEL=
TTS_VOICE=default
# Browser-reachable HTTPS origin for relative audio URLs returned by Oryx.
ORYX_PUBLIC_BASE_URL=https://oryx.gnx

MCP_CONFIG_PATH=config/mcp.json
HOST=127.0.0.1
PORT=8080
# Set before exposing voice.gnx, even with a loopback backend binding.
GNX_API_TOKEN=
REQUEST_TIMEOUT_MS=45000
VOICE_TIMEOUT_MS=15000
CORRELATION_TTL_MS=86400000
MAX_CORRELATIONS=1000
